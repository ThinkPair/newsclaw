{
  "name": "newsclaw-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean:chrome && npm run build:types && npm run build:bundle",
    "build:bundle": "node scripts/build.mjs",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "build:firefox": "npm run clean:firefox && npm run typecheck && node scripts/build.mjs --target firefox",
    "build:safari": "npm run clean:safari && npm run typecheck && node scripts/build.mjs --target safari",
    "clean": "npm run clean:chrome && npm run clean:firefox && npm run clean:safari",
    "clean:chrome": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean:firefox": "node -e \"require('node:fs').rmSync('dist-firefox',{recursive:true,force:true})\"",
    "clean:safari": "node -e \"require('node:fs').rmSync('dist-safari',{recursive:true,force:true})\"",
    "verify:assets": "node scripts/verify-build-assets.mjs --target chrome",
    "verify:assets:firefox": "node scripts/verify-build-assets.mjs --target firefox",
    "verify:assets:safari": "node scripts/verify-build-assets.mjs --target safari",
    "convert:safari": "node scripts/convert-safari.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types tests/newsclaw-extension-contract.test.ts",
    "package": "node scripts/package.mjs",
    "package:only": "node scripts/package.mjs --no-build",
    "package:firefox": "node scripts/package-firefox.mjs",
    "package:firefox:only": "node scripts/package-firefox.mjs --no-build",
    "package:safari": "node scripts/package-safari.mjs",
    "package:safari:only": "node scripts/package-safari.mjs --no-build",
    "sign:firefox": "node scripts/sign-firefox.mjs",
    "sign:firefox:only": "node scripts/sign-firefox.mjs --no-build",
    "webstore:upload": "node scripts/chrome-webstore-upload.mjs",
    "webstore:metadata": "node scripts/chrome-webstore-metadata.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.29",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.2",
    "web-ext": "^10.4.0"
  }
}
